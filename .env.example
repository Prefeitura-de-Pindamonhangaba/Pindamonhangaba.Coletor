# Desenvolvimento: docker compose up (PostgreSQL local e migrações automáticas).
# Produção: aplicar migrações antes de subir; consulte docs/autenticacao-e-chaves.md.
APP_PORT=3000
# URL pública exata, sem caminho. Ajuste junto com APP_PORT; produção usa HTTPS.
APP_URL=http://localhost:3000
DATABASE_EXTERNAL=true
DATABASE_URL=
# Exemplo: postgresql://usuario:senha@servidor:5432/coletor?sslmode=require

# Mesmo padrão do DadosPinda: Better Auth + Keycloak OIDC/PKCE.
# false exibe o login, mas não libera acesso às páginas/APIs internas.
KEYCLOAK_ENABLED=false
# URL HTTPS completa do realm, incluindo /realms/NOME_DO_REALM.
KEYCLOAK_ISSUER=
# Papéis viewer/operator/admin deste cliente devem constar no ID token.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# HTTP no IdP apenas em desenvolvimento com APP_URL HTTP local.
KEYCLOAK_ALLOW_INSECURE_HTTP=false
# Segredo aleatório de pelo menos 32 caracteres (sessões e tokens OAuth).
# Gerar: bun -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# Chave AES-256 exclusiva: 32 bytes em 64 caracteres hexadecimais.
# Mantenha um backup protegido; trocar exige recriptografar as credenciais.
# Gerar: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INTEGRATION_KEYS_ENCRYPTION_KEY=

# Chaves GCC e de outros sistemas são cadastradas por usuário em Minhas chaves.
# GCC_KEY e COLLECTOR_ACCESS_TOKEN não são mais utilizados.
