# Chave GCC emitida pelo administrador. Nunca utilizar NEXT_PUBLIC_.
GCC_KEY=
# Gere um segredo com pelo menos 32 caracteres e forneça aos operadores autorizados.
COLLECTOR_ACCESS_TOKEN=

# Docker de desenvolvimento funciona sem .env (banco local automático).
# Produção: docker compose -f compose.production.yml up --build -d
DATABASE_EXTERNAL=true
DATABASE_URL=
# Exemplo: postgresql://usuario:senha@servidor:5432/coletor?sslmode=require
APP_PORT=3000
